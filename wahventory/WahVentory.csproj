<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Author>wah</Author>
    <Name>wahventory (Refresh Fork)</Name>
    <Punchline>Advanced inventory management with safety filters and auto-discard</Punchline>
    <Description>An inventory management plugin
• Smart safety filters
• Market price integration via Universalis
• Bulk discard functionality
• Category grouping and search
• Gearset protection
• /wahventory refresh command (MagicalMontra fork)
• Refresh/discard completion reporting
• Inventory right-click discard and blacklist submenu</Description>
    <RepoUrl>https://github.com/MagicalMontra/wahventory</RepoUrl>
    <Tags>inventory;management;discard;filter;utility</Tags>
    <ApplicableVersion>any</ApplicableVersion>
    <AssemblyName>wahventory</AssemblyName>
    <Version>20.0.0.7</Version>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8600</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
